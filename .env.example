# Servidor da nuvem (aurora-whisper-server serve; ADR-019, F3). Nenhum valor
# real entra aqui: os segredos são gerados por quem roda, fora do repositório
# (docs/ai-spec/10-env-and-secrets.md e docs/teste-manual-nuvem-f3.md).

# Ambiente e URLs
APP_ENV=development
# https; http só para localhost e 127.0.0.1 (o PC). O Host dos pedidos tem de
# ser o dela, e o redirect do Google é ela + /auth/google/callback.
PUBLIC_BASE_URL=http://localhost:8080
HTTP_ADDR=127.0.0.1:8080
# Opcional: o IP (ou a rede CIDR) do proxy que termina o HTTPS na frente. Só
# dele o X-Forwarded-For vale.
PROXY_CONFIAVEL=

# Database
DATABASE_URL=

# Security: pelo menos 32 caracteres cada, diferentes entre si.
SESSION_SECRET=
DEVICE_TOKEN_PEPPER=

# Os três segredos acima também vêm de arquivo (F11c): o caminho de um arquivo
# de uma linha só, como o segredo montado no contêiner. Use a variável comum OU
# a _FILE, nunca as duas (o servidor não sobe).
DATABASE_URL_FILE=
SESSION_SECRET_FILE=
DEVICE_TOKEN_PEPPER_FILE=

# Google OAuth: o caminho do JSON do client Web baixado do Google Cloud,
# guardado FORA do repositório. O client_id, o client_secret e os
# redirect_uris vêm dele.
GOOGLE_CLIENT_SECRET_FILE=

# Os e-mails que podem entrar, separados por vírgula. Vazia, o servidor não
# sobe.
CONTAS_PERMITIDAS=

# O app (ADR-019, F4): a pasta do build da nuvem do painel, com o index.html
# (pnpm build:nuvem em web, que sai em web/dist-nuvem). O servidor a lê na
# subida. Vazia, ou sem o index.html, o servidor não sobe.
PAINEL_DIR=

# ASR Cloud (opcional)
ASR_CLOUD_PROVIDER=
ASR_CLOUD_MODEL=
ASR_CLOUD_API_KEY=

# Context Provider (opcional)
CONTEXT_PROVIDER=
CONTEXT_MODEL=
CONTEXT_API_KEY=

# Updates (opcional)
UPDATE_FEED_SOURCE=
GITHUB_TOKEN=

# Logs. A linha "retenção" do job (ADR-019, F9) é INFO: com warn ou error ela
# some. Os prazos da retenção (os 6 meses e os 30 dias da lixeira) não são
# configuração: são os mesmos no push, no job e no PC.
LOG_LEVEL=info

# Inference (opcional)
# INFERENCE_ENABLED=
# INFERENCE_MODEL_ID=
# INFERENCE_MAX_CONCURRENCY=
# INFERENCE_MEMORY_LIMIT=
# INFERENCE_TIMEOUT=
